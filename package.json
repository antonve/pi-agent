{
  "name": "agentbox-pi-setup",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "extensions/ask-user",
      "extensions/copy-all",
      "extensions/file-search",
      "extensions/git-info",
      "extensions/model-info",
      "extensions/summaries",
      "extensions/ui-customization",
      "extensions/orchestration"
    ],
    "skills": [
      "skills"
    ],
    "themes": [
      "themes"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "format": "prettier --write \"extensions/**/*.{ts,cjs}\" \"*.json\" \"themes/*.json\"",
    "format:check": "prettier --check \"extensions/**/*.{ts,cjs}\" \"*.json\" \"themes/*.json\"",
    "test": "node --test --experimental-strip-types extensions/**/*.test.ts && vitest run extensions/file-search/index.spec.ts",
    "smoke": "pi --offline --no-session --print --no-tools --extension ./extensions/ask-user/index.ts --extension ./extensions/copy-all/index.ts --extension ./extensions/file-search/index.ts --extension ./extensions/git-info/index.ts --extension ./extensions/model-info/index.ts --extension ./extensions/summaries/index.ts --extension ./extensions/ui-customization/index.ts --extension ./extensions/orchestration/index.ts 'reply ok'"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.99",
    "acorn": "8.17.0",
    "effect": "4.0.0-beta.99",
    "ioredis": "5.9.3"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@effect/vitest": "4.0.0-beta.99",
    "@types/node": "24.10.13",
    "prettier": "3.8.2",
    "typebox": "1.3.6",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
